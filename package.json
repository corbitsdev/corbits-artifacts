{
  "name": "@corbits/artifacts",
  "version": "0.2.1",
  "type": "module",
  "license": "LGPL-2.1-only",
  "description": "Artifacts, versions and uploads with a pluggable ContentStore, mountable onto any Interchange host. Requires @intx 0.2.2 or newer.",
  "keywords": [
    "corbits",
    "interchange",
    "intx",
    "artifacts",
    "uploads",
    "content-store",
    "hono",
    "drizzle",
    "postgres"
  ],
  "author": "Corbits",
  "homepage": "https://github.com/corbitsdev/corbits-artifacts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-artifacts.git"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-artifacts/issues"
  },
  "corbits": {
    "minimumIntxVersion": "0.2.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sidecar-bundle": {
      "bun": "./src/sidecar-bundle.ts",
      "types": "./dist/sidecar-bundle.d.ts",
      "default": "./dist/sidecar-bundle.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-helpers.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "pretest": "bun run scripts/check-deps.ts",
    "test": "bun run pretest && bun test src",
    "test:coverage": "bun run pretest && bun test --coverage src",
    "test:package": "bun run test",
    "test:acceptance": "bun run build && bun test --cwd examples/reference-host"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3"
  },
  "peerDependencies": {
    "@intx/types": "^0.3.0",
    "arktype": "^2.1.29",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-openapi": "^1.2.0",
    "postgres": "^3.4.9",
    "@intx/hub-api": "^0.3.0",
    "@intx/agent": "^0.3.0"
  },
  "devDependencies": {
    "@intx/types": "0.3.0",
    "@types/bun": "1.1.14",
    "@types/node": "22.10.5",
    "arktype": "2.1.29",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.32",
    "hono-openapi": "1.2.0",
    "postgres": "3.4.9",
    "typescript": "5.7.2",
    "@intx/hub-api": "0.3.0",
    "@intx/authz": "0.3.0",
    "@intx/agent": "0.3.0"
  },
  "overrides": {
    "drizzle-orm": "0.45.2"
  }
}
