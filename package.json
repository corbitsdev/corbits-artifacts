{
  "name": "@corbits/artifacts",
  "version": "0.2.0",
  "description": "Artifacts, versions and uploads with a pluggable ContentStore, mountable onto any Interchange host. Requires @intx 0.4.0 or newer.",
  "keywords": [
    "artifacts",
    "content-store",
    "corbits",
    "drizzle",
    "hono",
    "interchange",
    "intx",
    "postgres",
    "uploads"
  ],
  "homepage": "https://github.com/corbitsdev/corbits-artifacts#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-artifacts/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-artifacts.git"
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sidecar-bundle": {
      "types": "./dist/sidecar-bundle.d.ts",
      "default": "./dist/sidecar-bundle.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test src",
    "test:e2e": "bun test e2e",
    "test:coverage": "bun test --coverage src e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@corbits/artifacts-0.1.0": "npm:@corbits/artifacts@0.1.0",
    "@intx/agent": "0.4.0",
    "@intx/authz": "0.4.0",
    "@intx/db": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@intx/hub-common": "0.4.0",
    "@intx/hub-sessions": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.1.14",
    "@types/node": "22.10.5",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.32",
    "hono-openapi": "1.2.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postgres": "3.4.9",
    "typescript": "5.7.2"
  },
  "peerDependencies": {
    "@intx/agent": "^0.4.0",
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "@intx/types": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "hono-openapi": "^1.2.0",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "@intx/agent": {
      "optional": true
    }
  },
  "overrides": {
    "drizzle-orm": "0.45.2"
  },
  "engines": {
    "node": ">=24"
  },
  "corbits": {
    "minimumIntxVersion": "0.4.0"
  }
}
