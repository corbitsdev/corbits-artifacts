{
  "name": "@corbits/artifacts",
  "version": "0.1.0",
  "type": "module",
  "license": "LGPL-2.1-only",
  "description": "Artifacts, versions and uploads with a pluggable ContentStore, mountable onto any Interchange host. Requires @intx 0.2.2 or newer.",
  "keywords": [
    "corbits",
    "interchange",
    "intx",
    "artifacts",
    "uploads",
    "content-store",
    "hono",
    "drizzle",
    "postgres"
  ],
  "author": "Corbits",
  "homepage": "https://github.com/corbitsdev/corbits-artifacts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-artifacts.git",
    "directory": "packages/artifacts"
  },
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-artifacts/issues"
  },
  "corbits": {
    "minimumIntxVersion": "0.2.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/test-helpers.ts", "LICENSE", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "pretest": "bun run scripts/check-deps.ts",
    "test": "bun run pretest && bun test",
    "test:coverage": "bun run pretest && bun test --coverage"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3"
  },
  "peerDependencies": {
    "@intx/types": "^0.2.2",
    "arktype": "^2.1.29",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.32",
    "hono-openapi": "^1.2.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@intx/types": "0.2.2",
    "@types/bun": "1.1.14",
    "@types/node": "22.10.5",
    "arktype": "2.1.29",
    "drizzle-orm": "0.45.1",
    "hono": "4.12.32",
    "hono-openapi": "1.2.0",
    "postgres": "3.4.9",
    "typescript": "5.7.2"
  }
}
